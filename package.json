{
	"name": "@crutchcrew/oxlint-plugin-import-access",
	"version": "1.0.1",
	"description": "Oxlint JS plugin for import access via JSDoc @public, @package and @private, without a type checker",
	"keywords": [
		"import-access",
		"jsdoc",
		"oxlint",
		"oxlint-plugin",
		"package-private",
		"typescript"
	],
	"homepage": "https://github.com/crutchcrew/oxlint-plugin-import-access#readme",
	"bugs": {
		"url": "https://github.com/crutchcrew/oxlint-plugin-import-access/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/crutchcrew/oxlint-plugin-import-access.git"
	},
	"workspaces": [
		"src/__tests__/fixtures/packages/workspaces/*"
	],
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"bench": "bun bench/run.ts",
		"build": "bun run --parallel build:compile build:declaration",
		"build:compile": "bun build src/index.ts --outdir dist --format esm --target node --packages external",
		"build:declaration": "tsc -p tsconfig.build.json && bun scripts/fix-dts-extensions.ts",
		"check": "bun run --parallel fmt:check lint lockfile:check",
		"fmt": "oxfmt --write .",
		"fmt:check": "oxfmt --check .",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lockfile:check": "bun install --frozen-lockfile",
		"prebuild": "rm -rf dist",
		"prepare": "lefthook install",
		"prepublishOnly": "bun run build",
		"test": "vitest run --project unit",
		"test:coverage": "vitest run --project unit --coverage",
		"test:e2e": "vitest run --project e2e"
	},
	"dependencies": {
		"minimatch": "^10.2.6",
		"oxc-parser": "^0.155.0",
		"oxc-resolver": "^11.24.2"
	},
	"devDependencies": {
		"@fixture-package-third-party/has-sub-module": "file:src/__tests__/fixtures/packages/third-party/has-sub-module",
		"@fixture-package-third-party/missing-entrypoint": "file:src/__tests__/fixtures/packages/third-party/missing-entrypoint",
		"@fixture-package-third-party/with-exports-field": "file:src/__tests__/fixtures/packages/third-party/with-exports-field",
		"@fixture-package-workspace/has-sub-module": "workspace:*",
		"@fixture-package-workspace/missing-entrypoint": "workspace:*",
		"@fixture-package-workspace/with-exports-field": "workspace:*",
		"@oxlint/plugins": "^1.89.0",
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "^5.0.5",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"oxlint": ">=1.40.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"onFail": "warn"
		},
		"runtime": [
			{
				"name": "bun",
				"onFail": "warn"
			},
			{
				"name": "node",
				"version": ">=22.18.0",
				"onFail": "warn"
			}
		]
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}
